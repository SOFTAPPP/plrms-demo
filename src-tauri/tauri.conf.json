{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STRATA",
  "version": "1.0.0",
  "identifier": "com.winteg.strata",
  "build": {
    "devUrl": "http://127.0.0.1:5180",
    "frontendDist": "splash",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm desktop:prepare"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/backend/": "backend/"
    },
    "publisher": "Winteg Technologies",
    "copyright": "© Winteg Technologies",
    "category": "Business",
    "shortDescription": "Mine fleet, sensor and camera monitoring",
    "longDescription": "STRATA — live fleet, production, sensor, fuel and camera monitoring for open-pit mines. This build runs a complete simulated mine offline.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      }
    }
  }
}
