# Copy to .env to override any of these. Every value has a working default.
PORT=5180
HOST=127.0.0.1
# Where the SQLite database lives (created on first run). Default: ./data/plrms.db,
# or the app-data folder when running as the desktop app.
# DB_PATH=./data/plrms.db
# Session signing secret. If empty, one is generated once into data/.secret.
JWT_SECRET=
# The seeded administrator (used only when the database is first created).
ADMIN_EMAIL=aritradatt39@gmail.com
ADMIN_PASSWORD=Aritradutta@2005
# Simulation speed at start-up (1 = real time). Change live from the Demo Control panel.
SIM_SPEED=1
# Days of history generated when the database is created or the app was off for a while (max 14).
HISTORY_DAYS=7
